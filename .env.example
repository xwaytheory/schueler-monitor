# --- Discord ---
# Webhook (zalecany sposób): node src/cli-channel.js tworzy kanał + webhook i dopisuje URL tutaj.
DISCORD_WEBHOOK_URL=
# Token bota Discord - potrzebny tylko do automatycznego utworzenia kanału/webhooka.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_NAME=schueler-hex-pulsechain
DISCORD_CHANNEL_PARENT_ID=
DISCORD_CHANNEL_TOPIC=

# --- AI (OpenRouter) - opcjonalne; bez klucza działa darmowy fallback (pollinations.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Serwer ---
PORT=3010
HOST=127.0.0.1
# Pełny skan wszystkich źródeł (sekundy). Konta X przez r.jina.ai są serializowane
# (JINA_SPACING_MS), więc cykl trwa ~2 min; 180 s daje zapas.
SCAN_INTERVAL_SEC=180
# Szybka ścieżka: Interpol, oficjalne komunikaty, zapytania o wypuszczenie/ekstradycję.
FAST_SCAN_INTERVAL_SEC=30
# Ile źródeł pobierać równolegle (bez kont X — te idą pojedynczo).
MAX_FETCH_CONCURRENCY=12
# Odstęp między pobraniami profili X przez r.jina.ai (ms). Burst kończy się HTTP 429.
JINA_SPACING_MS=2500
# Wpisy opublikowane przed tą datą nie trafiają do alertów (zostają w archiwum jako tło).
CASE_START=2026-10-14
# Po przerwie w skanowaniu nie wysyłaj starszej kolejki jako nowości.
NOTIFY_MAX_AGE_HOURS=24
# Po tym czasie nowa wzmianka o tym samym zdarzeniu może znowu zaalarmować
# (np. wyrok tydzień po aresztowaniu). W oknie = jeden alert na zdarzenie.
STORY_REALERT_HOURS=24
# important = tylko oficjalne komunikaty i ważne zdarzenia; all = każde trafienie.
ALERT_POLICY=important
# Token panelu /ops i ręcznych akcji. Bez niego /ops jest wyłączony.
# Wygeneruj: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
BOOTSTRAP_LOOKBACK_HOURS=72
# Ile powiadomień leci na Discorda przy pierwszym uruchomieniu (reszta w panelu).
BOOTSTRAP_NOTIFY_LIMIT=5
# Twardy limit powiadomień na Discorda w ciągu doby.
MAX_NOTIFICATIONS_PER_DAY=40
# Minimalny odstęp między powiadomieniami (ms) - chroni rate limit Discorda.
MIN_NOTIFY_GAP_MS=2000
MAX_ITEMS_PER_SOURCE=40
REQUEST_TIMEOUT_MS=25000
